# Copy this file to .env and fill in your values. Never commit .env!

# --- LLM / embeddings provider -------------------------------------------
# "gemini" - Google Gemini via its OpenAI-compatible endpoint (free key: https://aistudio.google.com)
# "dial"   - EPAM DIAL (Azure OpenAI-compatible API)
# "openai" - OpenAI API or any OpenAI-compatible endpoint
PROVIDER=gemini

# Google Gemini
GEMINI_API_KEY=your-gemini-api-key
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# EPAM DIAL (used only when PROVIDER=dial)
DIAL_API_KEY=
DIAL_ENDPOINT=https://ai-proxy.lab.epam.com
DIAL_API_VERSION=2024-02-01

# OpenAI (used only when PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_BASE_URL=

# --- Embeddings ------------------------------------------------------------
# Gemini: gemini-embedding-001 (3072 dims) | DIAL: text-embedding-3-small-1 (1536) | OpenAI: text-embedding-3-small (1536)
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=3072
# Send `dimensions` to the API to get shorter vectors (only for models that support it)
EMBEDDING_SEND_DIMENSIONS=false
EMBEDDING_BATCH_SIZE=64

# --- Chat LLM (used from step 6) -------------------------------------------
# Gemini: gemini-3.5-flash | DIAL: gpt-4o | OpenAI: gpt-4o-mini
CHAT_MODEL=gemini-3.5-flash

# --- Vector DB -------------------------------------------------------------
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=orbitra_kb
